            version = "1.1.0"
          </span>
        </span>
        <span
          class="ant-code-line"
        >
          <!---->
          <!---->
          <!---->
          <!---->
          <span
            class="ant-code-line-content"
          />
        </span>
        <span
          class="ant-code-line"
        >
          <!---->
          <!---->
          <!---->
          <!---->
          <span
            class="ant-code-line-content"
          >
            [dependencies]
          </span>
        </span>
        <span
          class="ant-code-line"
        >
          <!---->
          <!---->
          <!---->
          <!---->
          <span
            class="ant-code-line-content"
          >
            serde = { version = "1.0", features = ["derive"] }
          </span>
        </span>
      </code>
    </pre>
  </div>
  <div
    class="ant-code css-var-root ant-code-css-var"
  >
    <!---->
    <pre
      class="ant-code-pre"
      dir="ltr"
      tabindex="0"
    >
      <code
        class="ant-code-code"
      >
        <span
          class="ant-code-line"
        >
          <!---->
          <!---->
          <!---->
          <!---->
          <span
            class="ant-code-line-content"
          >
            FROM node:22-alpine
          </span>
        </span>
        <span
          class="ant-code-line"
        >
          <!---->
          <!---->
          <!---->
          <!---->
          <span
            class="ant-code-line-content"
          >
            WORKDIR /app
          </span>
        </span>
        <span
          class="ant-code-line"
        >
          <!---->
          <!---->
          <!---->
          <!---->
          <span
            class="ant-code-line-content"
          >
            COPY . .
          </span>
        </span>
        <span
          class="ant-code-line"
        >
          <!---->
          <!---->
          <!---->
          <!---->
          <span
            class="ant-code-line-content"
          >
            RUN corepack enable && pnpm install --frozen-lockfile
          </span>
        </span>
        <span
          class="ant-code-line"
        >
          <!---->
          <!---->
          <!---->
          <!---->
          <span
            class="ant-code-line-content"
          >
            CMD ["pnpm", "start"]
          </span>
        </span>
      </code>
    </pre>
  </div>
</div>
`;

